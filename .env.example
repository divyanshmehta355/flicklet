# Flicklet Local Environment Configuration
# Add your Google Gemini API key below to enable AI title, genre, and year classification.
# Create a free key at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Add your The Movie Database (TMDB) API key (v3 auth) below to fetch official poster artwork and ratings.
# Create a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
